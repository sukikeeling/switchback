{
  "mcpServers": {
    "switchback-governance": {
      "command": "python",
      "args": [
        "-m",
        "switchback.cli",
        "mcp-stdio"
      ],
      "env": {
        "PYTHONUTF8": "1"
      },
      "note": "Switchback 原生标准 MCP JSON-RPC 2.0 Server：直接暴露六大核心治理 Skill 与 Merkle 审计/时光机回溯工具"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "${SWITCHBACK_WORKSPACE:-./switchback-run}"
      ],
      "note": "让 Worker Agent 经 MCP 安全访问工作区（账本/任务卡/trace），不直接持有文件系统权限——对应 AgentTeams 凭证透传模型"
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.7.4"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${SWITCHBACK_WORKSPACE:-./switchback-run}/mcp-memory.json"
      },
      "note": "AgentMemory 的 MCP 暴露：让 lessons-learned Skill 写回的记忆可跨 Agent 共享与检索"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github@2025.4.0"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "note": "京张 --live 模式与运行证据采集经此 MCP 拉取 PR/CI/check-run；Worker 只持消费者令牌，真实 PAT 存于 Higress 网关"
    }
  },
  "switchback_skills_via_mcp": {
    "note": "六大 Skill 已全部在 switchback/mcp_server.py 中实现为标准可执行 MCP Server Tool（同时支持 stdio 与 HTTP /v1/mcp/rpc）",
    "evidence-verify": {
      "transport": "stdio+http",
      "input_schema": "claims(dict) + sources(dict) + numeric_keys(list) + prose_text + table_data + api_payload + artifact_bundle",
      "output_schema": "VerificationReport{passed(bool), checks(list)}",
      "status": "implemented"
    },
    "grade-access": {
      "transport": "stdio+http",
      "input_schema": "payload(dict) + trust_score(float)",
      "output_schema": "Grade(enum: gentle/medium/steep)",
      "status": "implemented"
    },
    "kmarker-ledger": {
      "transport": "stdio+http",
      "input_schema": "task_id + label + payload(dict)",
      "output_schema": "KMarker{km, sha256, prev_sha} + merkle_root",
      "status": "implemented"
    },
    "risk-ledger": {
      "transport": "stdio+http",
      "input_schema": "risk_id + title + score + note + mitigation + human_review",
      "output_schema": "RiskEntry{id, score, flag}",
      "status": "implemented"
    },
    "switch-decision": {
      "transport": "stdio+http",
      "input_schema": "task_id + votes(list)",
      "output_schema": "Verdict{pass|turn_back|depot} + task_state",
      "status": "implemented"
    },
    "lessons-learned": {
      "transport": "stdio+http",
      "input_schema": "agent_id + content + tags(list)",
      "output_schema": "MemoryEntry",
      "status": "implemented"
    }
  }
}
